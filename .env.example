# --- Base de données ---------------------------------------------------------------
# Local sans Docker (PGlite, fichier dans .pglite/) :
DATABASE_URL=pglite:./.pglite
# Supabase (Settings → Database → Connection pooling, mode Transaction, port 6543) :
# DATABASE_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# --- Realtime (optionnel en local : sans ces variables, les clients sondent l'API) --
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Jeu ---------------------------------------------------------------------------
MJ_PASSWORD=change-moi
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Saut dans le temps (bots, répétitions). NE PAS activer le soir de la partie.
ALLOW_TIME_WARP=0
